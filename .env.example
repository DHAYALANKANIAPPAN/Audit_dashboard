# ==========================================
# AuditPulse 360 Environment Variables
# ==========================================

# Database (PostgreSQL with Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auditpulse360?schema=public"

# Redis (for BullMQ background jobs: reminders & escalations)
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_SECRET="auditpulse-secret-jwt-key-hackathon-2026"
JWT_EXPIRES_IN="7d"

# Backend Server Configuration
PORT=5000
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"

# MinIO (S3 Compatible Storage for Evidence Photos / PDFs)
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="audit-evidence"

# SMTP / Email Notification (Mock or Real)
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="AuditPulse 360 <noreply@auditpulse360.local>"
